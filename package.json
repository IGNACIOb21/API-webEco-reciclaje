{
  "name": "rebin-v2-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server.ts",
    "dev:pruebas": "npm run build:web && node scripts/dev-pruebas.cjs",
    "preparar:base-local": "node scripts/preparar-base-local.cjs",
    "preparar:operaciones-locales": "node scripts/preparar-operaciones-locales.cjs",
    "preparar:operaciones-locales-v2": "node scripts/preparar-operaciones-locales-v2.cjs",
    "preparar:operaciones-locales-v3": "node scripts/preparar-operaciones-locales-v3.cjs",
    "preparar:admin-local": "node scripts/preparar-admin-local.cjs",
    "probar:alta-local": "npm run build && node scripts/probar-alta-local.cjs",
    "probar:estado-local": "npm run build && node scripts/probar-estado-local.cjs",
    "verificar:acceso": "npm run build && node scripts/verificar-acceso.cjs",
    "build:web": "esbuild web/invitacion.ts --bundle --platform=browser --target=es2020 --outfile=dist-public/invitacion.js",
    "build": "tsc && npm run build:web",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:local": "npm run build && node test/integracion-local.cjs",
    "test:contrato-local": "node test/contrato-produccion-local.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.30",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "supabase": "3.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
